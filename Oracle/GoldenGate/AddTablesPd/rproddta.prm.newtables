REPLICAT rproddta
USERIDALIAS GG_ADM_DEST
ASSUMETARGETDEFS
--DISCARDFILE /oracle/goldengate/dirrpt/RPRODDTA.dsc, APPEND, MEGABYTES 200

REPORTCOUNT EVERY 30 MINUTES, RATE
REPORTROLLOVER AT 01:00 ON SUNDAY
DISCARDROLLOVER AT 01:00 ON SUNDAY

-- DDL PARAMETERS
DDL INCLUDE ALL
DDLOPTIONS REPORT

-- DDL ERRORS
DDLERROR 1435 IGNORE INCLUDE OPTYPE ALTER OBJTYPE SESSION

--DBOPTIONS INTEGRATEDPARAMS(PARALLELISM 8, EAGER_SIZE 30000, batchsql_mode sequential)
DBOPTIONS INTEGRATEDPARAMS(PARALLELISM 8, EAGER_SIZE 30000)
--DBOPTIONS INTEGRATEDPARAMS(EAGER_SIZE 35000)
DBOPTIONS SUPPRESSTRIGGERS
--REPERROR (0001, DISCARD)
--REPERROR (1403, DISCARD)
ALLOWNOOPUPDATES
APPLYNOOPUPDATES
INSERTMISSINGUPDATES
BATCHSQL
MAXSQLSTATEMENTS 100

--MAP_PARALLELISM 2
--MIN_APPLY_PARALLELISM 2
--MAX_APPLY_PARALLELISM 4
--SPLIT_TRANS_RECS 1000

MAP PRODCTL.*, TARGET PRODCTL.*;
MAP PRODDTA.F3412, TARGET PRODDTA.F3412, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F3460, TARGET PRODDTA.F3460, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F4013, TARGET PRODDTA.F4013, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F41171, TARGET PRODDTA.F41171, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F4140, TARGET PRODDTA.F4140, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F4141, TARGET PRODDTA.F4141, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5541040, TARGET PRODDTA.F5541040, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5541043, TARGET PRODDTA.F5541043, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5542087, TARGET PRODDTA.F5542087, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5542650, TARGET PRODDTA.F5542650, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5543006, TARGET PRODDTA.F5543006, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5543122, TARGET PRODDTA.F5543122, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5547073, TARGET PRODDTA.F5547073, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.F5548004, TARGET PRODDTA.F5548004, FILTER ( @GETENV ('TRANSACTION', 'CSN') > 2360933480417);
MAP PRODDTA.*, TARGET PRODDTA.*;
MAP SYS7333.*, TARGET SYS7333.*;