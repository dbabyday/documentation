EXTRACT etestdta

SETENV (ORACLE_SID=jdpy)
SETENV (ORACLE_HOME=/orahome/11.2.0.4.171017)
SETENV (TNS_ADMIN="/orahome/11.2.0.4.171017/network/admin")
-- setenv (NLS_LANG = "AMERICAN_AMERICA.AL32UTF8")
-- SETENV (LD_LIBRARY_PATH=/u01/app/oracle/product/10.2.0.1.0/lib:/usr/X/lib:/usr/openwin/lib:/usr/dt/lib)

USERIDALIAS GG_ADM_SOURCE
-- USERIDALIAS GG_ADM DOMAIN NA
-- CACHEMGR CACHESIZE 1G

EXTTRAIL /oracle/goldengate/dirdat/et
--DISCARDFILE /oracle/gg/12.1.2.1/discard/etestdta.dsc, append, megabytes 1000

DISCARDROLLOVER AT 01:00
STATOPTIONS REPORTFETCH
REPORTCOUNT EVERY 10 MINUTES, RATE
REPORTROLLOVER AT 01:00 ON SUNDAY

-- TRANLOGOPTIONS EXCLUDEUSER ggadmin
-- TRANSLOGOPTIONS EXCLUDEEUSER ggadm 
-- TRANLOGOPTIONS INTEGRATEDPARAMS (max_sga_size 1536, parallelism 3)
TRANLOGOPTIONS INTEGRATEDPARAMS (parallelism 3)

--- DDL Parameters
DDL INCLUDE MAPPED
DDLOPTIONS REPORT
LOGALLSUPCOLS
UPDATERECORDFORMAT COMPACT

NOCOMPRESSUPDATES
getupdatebefores
statoptions resetreportstats
report at 12:29
reportrollover at 12:30

-- NODYNAMICRESOLUTION
WILDCARDRESOLVE DYNAMIC

